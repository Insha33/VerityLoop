{
  "name": "verityloop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:marketing": "npm run dev --workspace=@verityloop/marketing",
    "dev:marketing:3100": "PORT=3100 npm run dev --workspace=@verityloop/marketing",
    "dev:dashboard": "npm run dev --workspace=@verityloop/dashboard",
    "build": "turbo run build",
    "build:marketing": "turbo run build --filter=@verityloop/marketing",
    "build:dashboard": "turbo run build --filter=@verityloop/dashboard",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "npm run test:watch --workspace=@verityloop/marketing",
    "test:e2e": "turbo run test:e2e --",
    "start:dashboard": "npm run start --workspace=@verityloop/dashboard",
    "preview:marketing": "wrangler dev",
    "start": "npm run preview:marketing",
    "deploy": "npm run deploy:marketing",
    "deploy:marketing": "wrangler deploy",
    "deploy:dashboard": "npm run deploy --workspace=@verityloop/dashboard",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy:check:dashboard": "npm run deploy:check --workspace=@verityloop/dashboard",
    "brand:assets": "npm run brand:assets --workspace=@verityloop/marketing"
  },
  "devDependencies": {
    "turbo": "^2.11.13",
    "wrangler": "^4.166.0"
  }
}
