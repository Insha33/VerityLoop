{
  "name": "verityloop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:marketing",
    "dev:marketing": "npm run dev --workspace=@verityloop/marketing",
    "build": "npm run build --workspaces --if-present",
    "build:marketing": "npm run build --workspace=@verityloop/marketing",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspace=@verityloop/marketing",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "npm run preview:marketing",
    "preview:marketing": "wrangler dev",
    "deploy": "npm run deploy:marketing",
    "deploy:marketing": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "dev:product": "npm run dev --workspace=@verityloop/product",
    "build:product": "npm run build --workspace=@verityloop/product",
    "start:product": "npm run start --workspace=@verityloop/product",
    "brand:assets": "npm run brand:assets --workspace=@verityloop/marketing"
  },
  "devDependencies": {
    "wrangler": "^4.123.0"
  }
}
